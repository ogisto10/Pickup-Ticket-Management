{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PickupManagementDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "PickupManagement.Api",
    "Audience": "PickupManagement.Ui",
    "SigningKey": "CHANGE_ME_USE_USER_SECRETS_OR_ENV_VAR_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 480
  },
  "PickupDefaults": {
    "WarehouseId": "MAIN",
    "AxDataAreaId": "DAT",
    "TicketPrefix": "A-",
    "BusinessTimeZone": "UTC",
    "QueuePolicy": "FIFO",
    "PartialOrderPolicy": "BLOCK_TICKET"
  },
  "AxAif": {
    "ServiceGroupName": "DOSI_PickupManagementServiceGroup",
    "EndpointUrl": "net.tcp://ax-aos:8201/DynamicsAx/Services/DOSI_PickupManagementServiceGroup",
    "DefaultDataAreaId": "DAT",
    "ReleaseClassName": "CONFIGURABLE_PENDING_AX_AUDIT",
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
